{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-register"
  ]
}